{
  "name": "jh-enterprises-dashboard",
  "private": true,
  "version": "2.7.1",
  "description": "SGA Balloon Merchant — Wholesale shop and multi-warehouse dashboard",
  "author": "SGA Balloon Merchant",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5199 --strictPort\" \"wait-on tcp:5199 && electron .\"",
    "electron:build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.21",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.sgaballoon.dashboard",
    "productName": "SGA Balloon Merchant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
